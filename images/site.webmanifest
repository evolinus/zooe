---
layout: none
# layout: none because the site-wide default in _config.yaml would otherwise
# wrap this file in the page template and serve HTML as the manifest.
# The front matter is here only so Jekyll runs Liquid over this file: the site is
# served from a subpath (/zooe), so the icon paths need relative_url or they
# 404 the same way the favicon links did
---
{
  "name": "zoo_eLab",
  "short_name": "zoo_e",
  "start_url": "{{ "/" | relative_url }}",
  "icons": [
    {
      "src": "{{ "images/web-app-manifest-192x192.png" | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{{ "images/web-app-manifest-512x512.png" | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
